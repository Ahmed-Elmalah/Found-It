# FOUND IT - environment values
# 1) Copy this file and name the copy:  .env
# 2) Fill the values (ask Ahmed for them, they are shared privately)
# 3) Never commit .env (it is in .gitignore)
#
# Where to find them: Supabase Dashboard -> Project Settings
#   SUPABASE_URL             -> Data API  -> Project URL
#   SUPABASE_PUBLISHABLE_KEY -> API Keys  -> Publishable key (sb_publishable_...)
#                               (or the legacy "anon public" key)
# NEVER put the secret / service_role key here.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
